    "tsx": "^4.23.9",
    "@vitest/expect": "^4.1.10",
    "@types/node": "^26.1.2",
    "typebox": "^1.3.6"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  }
